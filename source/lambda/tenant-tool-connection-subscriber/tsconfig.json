{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "lib": ["es2018", "dom"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "typeRoots": ["./node_modules/@types"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "moduleResolution": "Node",
    "rootDir": ".",
    "paths": {
      "@aws-sdk/client-bedrock-agentcore": [
        "../layers/aws-sdk-lib/node_modules/@aws-sdk/client-bedrock-agentcore"
      ],
      "@aws-sdk/client-eventbridge": ["../layers/aws-sdk-lib/node_modules/@aws-sdk/client-eventbridge"]
    }
  },
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
